# Copy to .env (which is gitignored) and fill in as needed.
# The agent defaults to a FREE local Ollama model, so no keys are required to run it.

# Provider: Ollama (default) or OpenAI
LLM__Provider=Ollama
# Optional model override (defaults: Ollama=llama3.2, OpenAI=gpt-4o-mini)
# LLM__Model=llama3.2

# Only needed when LLM__Provider=OpenAI
# OPENAI_API_KEY=sk-...
